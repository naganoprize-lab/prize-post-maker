{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the main window may open the X composer",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://x.com/intent/post?*"
        }
      ]
    },
    "dialog:allow-open"
  ]
}
